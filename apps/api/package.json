{
  "name": "@vigia/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:db": "cross-env VIGIA_DB_TESTS=1 vitest run test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migration:run": "tsx src/shared/database/migrate.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/typeorm": "^12.0.3",
    "@vigia/contracts": "workspace:*",
    "@vigia/epidemiology": "workspace:*",
    "chardet": "^2.2.0",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "fuzzball": "^2.2.6",
    "helmet": "^8.3.0",
    "iconv-lite": "^0.7.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.27",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.4.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
