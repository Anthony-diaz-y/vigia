# Copy to .env and replace every change-me value with a random one.

# PostgreSQL started by docker compose
POSTGRES_USER=vigia_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vigia

# API: same credentials as above
VIGIA_DATABASE_URL=postgresql://vigia_app:change-me@localhost:55432/vigia
VIGIA_AUTH_SECRET=change-me-to-a-random-value-of-at-least-32-characters
VIGIA_ADMIN_EMAIL=admin@vigia.local
VIGIA_ADMIN_PASSWORD=change-me

# Optional: DeepSeek names columns and writes summaries
# DEEPSEEK_API_KEY=
