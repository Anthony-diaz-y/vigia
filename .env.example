# vigia — environment template.
# Copy this file to `.env` and adjust it to your machine. `.env` is gitignored.

# Access token for the API and the dashboard token field.
VIGIA_ACCESS_TOKEN=vigia-dev

# Metadata database URL. Leave unset (or comment it out) for SQLite with zero
# setup. To use the Docker PostgreSQL defined in docker-compose.yml, uncomment:
# VIGIA_DATABASE_URL=postgresql+psycopg://vigia:vigia@localhost:55432/vigia

# Where uploads and analysis artifacts are stored (default: ./data).
# VIGIA_DATA_DIR=./data
