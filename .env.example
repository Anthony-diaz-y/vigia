# vigia — environment template.
# Copy this file to `.env` and adjust it to your machine. `.env` is gitignored.

# Access token for the API and the dashboard token field.
VIGIA_ACCESS_TOKEN=vigia-dev

# PostgreSQL for the TypeScript stack.
VIGIA_DATABASE_URL=postgresql://vigia:vigia@localhost:55432/vigia
VIGIA_TEST_DATABASE_URL=postgresql://vigia:vigia@localhost:55432/vigia_test
VIGIA_DATABASE_SSL=false

# Optional target override for the backfill CLI when the runtime database and
# the backfill target differ.
# VIGIA_TS_DATABASE_URL=postgresql://vigia:vigia@localhost:55432/vigia

# Optional narrative provider for /api/explain and /api/recommendations.
# Without a key both return the deterministic Spanish template. The LLM only
# writes prose over aggregated data; it never decides levels or actions.
# DEEPSEEK_API_KEY=

# NestJS API.
PORT=3001
VIGIA_CORS_ORIGINS=http://localhost:3000
# Next.js rewrites /api/* to this origin. Set it to the deployed API in
# production; the dashboard never talks to the API directly.
VIGIA_API_URL=http://localhost:3001

# Where raw uploads and generated artifacts are stored (default: ./data).
# VIGIA_DATA_DIR=./data
