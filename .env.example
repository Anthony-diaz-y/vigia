# vigia — environment template.
# Copy this file to `.env` and adjust it to your machine. `.env` is gitignored.

# Access token for the API and the dashboard token field.
VIGIA_ACCESS_TOKEN=vigia-dev

# PostgreSQL for the target TypeScript stack and the Python transition.
# The Python service accepts the SQLAlchemy `postgresql+psycopg://` form; the
# NestJS API normalizes it automatically.
VIGIA_DATABASE_URL=postgresql+psycopg://vigia:vigia@localhost:55432/vigia
# During the strangler period the TypeScript API uses its own database so the
# legacy Python schema (public.uploads) and the new schema can coexist.
VIGIA_TS_DATABASE_URL=postgresql://vigia:vigia@localhost:55432/vigia_ts
VIGIA_TEST_DATABASE_URL=postgresql://vigia:vigia@localhost:55432/vigia_test
VIGIA_DATABASE_SSL=false

# NestJS API (the Python API keeps using its own defaults).
PORT=3001
VIGIA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Where raw uploads and generated artifacts are stored (default: ./data).
# VIGIA_DATA_DIR=./data
